{% doc %}
  @prompt
    modal con carrusel autoplay, que solo salga una vez por usuario, que tenga titutulo y subtitulo, 
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-modal-carousel-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .ai-modal-carousel-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-modal-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-modal-carousel-content-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.modal_width }}%;
    max-width: 800px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    z-index: 10000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .ai-modal-carousel-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: {{ block.settings.text_color }};
    z-index: 10001;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-modal-carousel-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-modal-carousel-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 20px;
  }

  .ai-modal-carousel-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 10px;
  }

  .ai-modal-carousel-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.8;
  }

  .ai-modal-carousel-slider-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-modal-carousel-slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-modal-carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
  }

  .ai-modal-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-modal-carousel-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-modal-carousel-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-modal-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.3s ease;
  }

  .ai-modal-carousel-nav-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-modal-carousel-nav-prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-modal-carousel-nav-next-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-modal-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-modal-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-modal-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-modal-carousel-content-{{ ai_gen_id }} {
      width: 90%;
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-modal-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-modal-carousel-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<modal-carousel-{{ ai_gen_id }}
  class="ai-modal-carousel-{{ ai_gen_id }}"
  data-autoplay-delay="{{ block.settings.autoplay_delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-modal-carousel-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-modal-carousel-content-{{ ai_gen_id }}">
    <button
      class="ai-modal-carousel-close-{{ ai_gen_id }}"
      aria-label="Cerrar modal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-modal-carousel-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-modal-carousel-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-modal-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-modal-carousel-slider-{{ ai_gen_id }}">
      <div class="ai-modal-carousel-slides-{{ ai_gen_id }}">
        {% if block.settings.image_1 != blank %}
          <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_1 | image_url: width: 1200 }}"
              alt="{{ block.settings.image_1.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_1.width }}"
              height="{{ block.settings.image_1.height }}"
            >
          </div>
        {% else %}
          <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
            <div class="ai-modal-carousel-slide-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.image_2 != blank %}
          <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_2 | image_url: width: 1200 }}"
              alt="{{ block.settings.image_2.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_2.width }}"
              height="{{ block.settings.image_2.height }}"
            >
          </div>
        {% endif %}

        {% if block.settings.image_3 != blank %}
          <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_3 | image_url: width: 1200 }}"
              alt="{{ block.settings.image_3.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_3.width }}"
              height="{{ block.settings.image_3.height }}"
            >
          </div>
        {% endif %}

        {% if block.settings.image_4 != blank %}
          <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_4 | image_url: width: 1200 }}"
              alt="{{ block.settings.image_4.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_4.width }}"
              height="{{ block.settings.image_4.height }}"
            >
          </div>
        {% endif %}

        {% if block.settings.image_5 != blank %}
          <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_5 | image_url: width: 1200 }}"
              alt="{{ block.settings.image_5.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_5.width }}"
              height="{{ block.settings.image_5.height }}"
            >
          </div>
        {% endif %}
      </div>

      <button
        class="ai-modal-carousel-nav-{{ ai_gen_id }} ai-modal-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Anterior"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-modal-carousel-nav-{{ ai_gen_id }} ai-modal-carousel-nav-next-{{ ai_gen_id }}"
        aria-label="Siguiente"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-modal-carousel-dots-{{ ai_gen_id }}"></div>
  </div>
</modal-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ModalCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
        this.cookieName = 'modal_carousel_{{ ai_gen_id }}_shown';
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-modal-carousel-slide-{{ ai_gen_id }}');
        this.slidesContainer = this.querySelector('.ai-modal-carousel-slides-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-modal-carousel-dots-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-modal-carousel-close-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-modal-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-modal-carousel-nav-next-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-modal-carousel-overlay-{{ ai_gen_id }}');
        this.autoplayDelay = parseInt(this.dataset.autoplayDelay) * 1000;

        this.createDots();
        this.setupEventListeners();
        this.checkAndShowModal();
      }

      checkAndShowModal() {
        if (!this.getCookie(this.cookieName)) {
          setTimeout(() => {
            this.showModal();
          }, 500);
        }
      }

      showModal() {
        this.classList.add('active');
        document.body.style.overflow = 'hidden';
        this.startAutoplay();
      }

      hideModal() {
        this.classList.remove('active');
        document.body.style.overflow = '';
        this.stopAutoplay();
        this.setCookie(this.cookieName, 'true', 365);
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.slides.length; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-modal-carousel-dot-{{ ai_gen_id }}');
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
        this.dots = this.querySelectorAll('.ai-modal-carousel-dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.hideModal());
        this.overlay.addEventListener('click', () => this.hideModal());
        this.prevButton.addEventListener('click', () => this.prevSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());

        document.addEventListener('keydown', (e) => {
          if (!this.classList.contains('active')) return;
          if (e.key === 'Escape') this.hideModal();
          if (e.key === 'ArrowLeft') this.prevSlide();
          if (e.key === 'ArrowRight') this.nextSlide();
        });
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
        this.resetAutoplay();
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        this.updateSlider();
        this.resetAutoplay();
      }

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.updateSlider();
        this.resetAutoplay();
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.slidesContainer.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        if (this.autoplayDelay > 0) {
          this.autoplayInterval = setInterval(() => {
            this.nextSlide();
          }, this.autoplayDelay);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        this.stopAutoplay();
        this.startAutoplay();
      }

      setCookie(name, value, days) {
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        const expires = 'expires=' + date.toUTCString();
        document.cookie = name + '=' + value + ';' + expires + ';path=/';
      }

      getCookie(name) {
        const nameEQ = name + '=';
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
          let c = ca[i];
          while (c.charAt(0) === ' ') c = c.substring(1, c.length);
          if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('modal-carousel-{{ ai_gen_id }}', ModalCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Modal con carrusel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "¡Bienvenido!"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Descubre nuestras últimas novedades"
    },
    {
      "type": "header",
      "content": "Imágenes del carrusel"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Imagen 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Imagen 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Imagen 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Imagen 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Imagen 5"
    },
    {
      "type": "header",
      "content": "Configuración del carrusel"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Tiempo entre diapositivas",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Estilo del modal"
    },
    {
      "type": "range",
      "id": "modal_width",
      "label": "Ancho del modal",
      "min": 50,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio de borde del modal",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Espaciado interno",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Radio de borde de imágenes",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color del overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del overlay",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Tamaño del subtítulo",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Navegación"
    },
    {
      "type": "color",
      "id": "nav_button_color",
      "label": "Color de botones de navegación",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_button_icon_color",
      "label": "Color de iconos de navegación",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Color de indicadores",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Modal con carrusel"
    }
  ]
}
{% endschema %}
