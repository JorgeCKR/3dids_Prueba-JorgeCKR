{% doc %}
  @prompt
    modal con carrusel autoplay, que solo salga una vez por usuario, que tenga titutulo y subtitulo, 
    
    , El contenedor modal debe aparecer centrado en la pagina sin importar el tamaño de las imagenes
    
    Las imagenes deben pasar sin detenerse y al acabrse repetir nuevamente sinmostrar regreso de forma continua
    
    se debe poder cerrar manualmente y aparecer cuando el usuario quiere dejar la pagina, Las imagenes deben pasar de forma continua sin detenerse
    
    debo opder ajustar el ancho y el largo del modal y de las imagenes
    
    Debe superponerse en la pantalla para poder cerrarlo 
    
    Debo poder elegir cuantas fotos agregar, siempre mas de 5
    
    Lo demas mantenlo que esta perfecto
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-modal-carousel-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .ai-modal-carousel-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-modal-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    cursor: pointer;
  }

  .ai-modal-carousel-content-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.modal_width }}%;
    height: {{ block.settings.modal_height }}vh;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    z-index: 10000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
  }

  .ai-modal-carousel-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: {{ block.settings.close_button_bg }};
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.close_button_color }};
    z-index: 10001;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: opacity 0.3s ease;
  }

  .ai-modal-carousel-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-modal-carousel-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .ai-modal-carousel-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 10px;
  }

  .ai-modal-carousel-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.8;
  }

  .ai-modal-carousel-slider-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .ai-modal-carousel-slides-{{ ai_gen_id }} {
    display: flex;
    height: 100%;
    will-change: transform;
  }

  .ai-modal-carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-modal-carousel-slide-{{ ai_gen_id }} img {
    width: {{ block.settings.image_width }}%;
    height: {{ block.settings.image_height }}%;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-modal-carousel-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-modal-carousel-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-modal-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    flex-shrink: 0;
  }

  .ai-modal-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-modal-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-modal-carousel-content-{{ ai_gen_id }} {
      width: 90%;
      height: auto;
      max-height: 90vh;
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-modal-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-modal-carousel-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<modal-carousel-{{ ai_gen_id }}
  class="ai-modal-carousel-{{ ai_gen_id }}"
  data-autoplay-delay="{{ block.settings.autoplay_delay }}"
  data-transition-speed="{{ block.settings.transition_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-modal-carousel-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-modal-carousel-content-{{ ai_gen_id }}">
    <button
      class="ai-modal-carousel-close-{{ ai_gen_id }}"
      aria-label="Cerrar modal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-modal-carousel-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-modal-carousel-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-modal-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-modal-carousel-slider-{{ ai_gen_id }}">
      <div class="ai-modal-carousel-slides-{{ ai_gen_id }}">
        {% assign image_count = 0 %}
        {% for i in (1..20) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign current_image = block.settings[image_key] %}
          {% if current_image != blank %}
            {% assign image_count = image_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if image_count == 0 %}
          <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
            <div class="ai-modal-carousel-slide-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          </div>
        {% else %}
          {% for i in (1..20) %}
            {% assign image_key = 'image_' | append: i %}
            {% assign current_image = block.settings[image_key] %}
            {% if current_image != blank %}
              <div class="ai-modal-carousel-slide-{{ ai_gen_id }}">
                <img
                  src="{{ current_image | image_url: width: 1600 }}"
                  alt="{{ current_image.alt | escape }}"
                  loading="lazy"
                  width="{{ current_image.width }}"
                  height="{{ current_image.height }}"
                >
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="ai-modal-carousel-dots-{{ ai_gen_id }}"></div>
  </div>
</modal-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ModalCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
        this.cookieName = 'modal_carousel_{{ ai_gen_id }}_shown';
        this.exitIntentBound = this.handleExitIntent.bind(this);
        this.isTransitioning = false;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-modal-carousel-slide-{{ ai_gen_id }}');
        this.slidesContainer = this.querySelector('.ai-modal-carousel-slides-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-modal-carousel-dots-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-modal-carousel-close-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-modal-carousel-overlay-{{ ai_gen_id }}');
        this.autoplayDelay = parseInt(this.dataset.autoplayDelay) * 1000;
        this.transitionSpeed = parseFloat(this.dataset.transitionSpeed) * 1000;

        if (this.slides.length > 1) {
          this.cloneSlides();
          this.createDots();
        }
        
        this.setupEventListeners();
        this.checkAndShowModal();
      }

      cloneSlides() {
        const firstSlide = this.slides[0].cloneNode(true);
        const lastSlide = this.slides[this.slides.length - 1].cloneNode(true);
        
        this.slidesContainer.appendChild(firstSlide);
        this.slidesContainer.insertBefore(lastSlide, this.slides[0]);
        
        this.allSlides = this.querySelectorAll('.ai-modal-carousel-slide-{{ ai_gen_id }}');
        this.currentSlide = 1;
        this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;
      }

      checkAndShowModal() {
        if (!this.getCookie(this.cookieName)) {
          document.addEventListener('mouseleave', this.exitIntentBound);
        }
      }

      handleExitIntent(e) {
        if (e.clientY <= 0 && !this.classList.contains('active')) {
          this.showModal();
          document.removeEventListener('mouseleave', this.exitIntentBound);
        }
      }

      showModal() {
        this.classList.add('active');
        document.body.style.overflow = 'hidden';
        if (this.slides.length > 1) {
          this.startAutoplay();
        }
      }

      hideModal() {
        this.classList.remove('active');
        document.body.style.overflow = '';
        this.stopAutoplay();
        this.setCookie(this.cookieName, 'true', 365);
        document.removeEventListener('mouseleave', this.exitIntentBound);
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.slides.length; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-modal-carousel-dot-{{ ai_gen_id }}');
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(i + 1));
          this.dotsContainer.appendChild(dot);
        }
        this.dots = this.querySelectorAll('.ai-modal-carousel-dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.hideModal());
        this.overlay.addEventListener('click', () => this.hideModal());

        if (this.slides.length > 1) {
          this.slidesContainer.style.transition = `transform ${this.transitionSpeed}ms linear`;
          
          this.slidesContainer.addEventListener('transitionend', () => {
            if (this.isTransitioning) {
              return;
            }

            if (this.currentSlide === 0) {
              this.isTransitioning = true;
              this.slidesContainer.style.transition = 'none';
              this.currentSlide = this.slides.length;
              this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;
              setTimeout(() => {
                this.slidesContainer.style.transition = `transform ${this.transitionSpeed}ms linear`;
                this.isTransitioning = false;
              }, 50);
            } else if (this.currentSlide === this.allSlides.length - 1) {
              this.isTransitioning = true;
              this.slidesContainer.style.transition = 'none';
              this.currentSlide = 1;
              this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;
              setTimeout(() => {
                this.slidesContainer.style.transition = `transform ${this.transitionSpeed}ms linear`;
                this.isTransitioning = false;
              }, 50);
            }
            this.updateDots();
          });
        }

        document.addEventListener('keydown', (e) => {
          if (!this.classList.contains('active')) return;
          if (e.key === 'Escape') this.hideModal();
        });
      }

      goToSlide(index) {
        if (this.isTransitioning) return;
        this.stopAutoplay();
        this.currentSlide = index;
        this.updateSlider();
        this.startAutoplay();
      }

      nextSlide() {
        if (this.isTransitioning) return;
        this.currentSlide++;
        this.updateSlider();
      }

      updateSlider() {
        this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;
        this.updateDots();
      }

      updateDots() {
        if (!this.dots) return;
        
        let actualIndex = this.currentSlide - 1;
        if (actualIndex < 0) actualIndex = this.slides.length - 1;
        if (actualIndex >= this.slides.length) actualIndex = 0;

        this.dots.forEach((dot, index) => {
          if (index === actualIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        if (this.autoplayDelay > 0 && this.slides.length > 1) {
          this.autoplayInterval = setInterval(() => {
            this.nextSlide();
          }, this.autoplayDelay);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      setCookie(name, value, days) {
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        const expires = 'expires=' + date.toUTCString();
        document.cookie = name + '=' + value + ';' + expires + ';path=/';
      }

      getCookie(name) {
        const nameEQ = name + '=';
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
          let c = ca[i];
          while (c.charAt(0) === ' ') c = c.substring(1, c.length);
          if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
      }

      disconnectedCallback() {
        this.stopAutoplay();
        document.removeEventListener('mouseleave', this.exitIntentBound);
      }
    }

    customElements.define('modal-carousel-{{ ai_gen_id }}', ModalCarousel{{ ai_gen_id }});
  })();
</script>

