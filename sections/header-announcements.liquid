

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;"
>
  <div class="announcement-bar__layout">

    {%- comment -%} ── IZQUIERDA (3): Icono pin + país actual → abre modal ── {%- endcomment -%}
    <div class="announcement-bar__side announcement-bar__side--left">
      <button
        type="button"
        class="announcement-bar__location-btn"
        aria-haspopup="dialog"
        aria-controls="location-modal"
        on:click="#location-modal/showDialog"
      >
        <span class="announcement-bar__location-icon">
          <svg width="10" height="13" viewBox="0 0 12 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 0C3.239 0 1 2.239 1 5c0 4.418 5 11 5 11s5-6.582 5-11c0-2.761-2.239-5-5-5Zm0 7.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" fill="currentColor"/>
          </svg>
        </span>
        <span class="announcement-bar__location-name">
          {{ localization.country.name }}
        </span>
      </button>
    </div>

    {%- comment -%} ── CENTRO (6): Slider de anuncios original intacto ── {%- endcomment -%}
    <div class="announcement-bar__center">
      {% liquid
        assign autoplay = false
        assign show_arrows = false
        if section.blocks.size > 1
          assign autoplay = true
          assign show_arrows = true
        endif
      %}
      <announcement-bar-component
        class="announcement-bar__slider"
        {% if autoplay == true %}
          autoplay="{{ section.settings.speed }}" aria-live="polite"
        {% endif %}
      >
        {% if show_arrows %}
          {% render 'slideshow-arrows', icon_style: 'chevron' %}
        {% endif %}
        <div class="announcement-bar__slides">
          {% content_for 'blocks' %}
        </div>
      </announcement-bar-component>
    </div>

    {%- comment -%} ── DERECHA (3): Profesional + Selector de idioma nativo ── {%- endcomment -%}
    <div class="announcement-bar__side announcement-bar__side--right">

      {% if section.settings.show_professional_link %}
        <a href="{{ section.settings.professional_url }}" class="announcement-bar__side-link">
          {{ section.settings.professional_label | default: 'Profesional' }}
        </a>
        <span class="announcement-bar__side-divider">|</span>
      {% endif %}

      {% if section.settings.show_language_selector %}
        {%- comment -%}
          Bandera del idioma activo — mapeamos iso_code → emoji
        {%- endcomment -%}
        {%- assign current_locale = request.locale.iso_code -%}
        {%- case current_locale -%}
          {%- when 'es' -%}{%- assign active_flag = '🇪🇸' -%}
          {%- when 'en' -%}{%- assign active_flag = '🇬🇧' -%}
          {%- when 'fr' -%}{%- assign active_flag = '🇫🇷' -%}
          {%- when 'de' -%}{%- assign active_flag = '🇩🇪' -%}
          {%- when 'it' -%}{%- assign active_flag = '🇮🇹' -%}
          {%- when 'nl' -%}{%- assign active_flag = '🇳🇱' -%}
          {%- when 'pt' -%}{%- assign active_flag = '🇵🇹' -%}
          {%- when 'ru' -%}{%- assign active_flag = '🇷🇺' -%}
          {%- when 'pl' -%}{%- assign active_flag = '🇵🇱' -%}
          {%- when 'cs' -%}{%- assign active_flag = '🇨🇿' -%}
          {%- when 'sv' -%}{%- assign active_flag = '🇸🇪' -%}
          {%- when 'da' -%}{%- assign active_flag = '🇩🇰' -%}
          {%- else -%}{%- assign active_flag = '🌐' -%}
        {%- endcase -%}

        <div class="announcement-bar__lang">
          <button
            type="button"
            class="announcement-bar__lang-trigger"
            aria-expanded="false"
            aria-controls="announcement-lang-dropdown"
          >
            <span class="announcement-bar__lang-flag" aria-hidden="true">{{ active_flag }}</span>
            <span class="announcement-bar__lang-name">{{ request.locale.endonym_name }}</span>
            <span class="announcement-bar__lang-caret" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </button>

          {%- comment -%}
            Dropdown nativo — usa locale.root_url igual que el header de Horizon
            Esto hace el cambio real de idioma sin JS adicional
          {%- endcomment -%}
          <ul
            id="announcement-lang-dropdown"
            class="announcement-bar__lang-dropdown"
            role="list"
            hidden
          >
            {% for locale in shop.published_locales %}
              {%- case locale.iso_code -%}
                {%- when 'es' -%}{%- assign lc_flag = '🇪🇸' -%}
                {%- when 'en' -%}{%- assign lc_flag = '🇬🇧' -%}
                {%- when 'fr' -%}{%- assign lc_flag = '🇫🇷' -%}
                {%- when 'de' -%}{%- assign lc_flag = '🇩🇪' -%}
                {%- when 'it' -%}{%- assign lc_flag = '🇮🇹' -%}
                {%- when 'nl' -%}{%- assign lc_flag = '🇳🇱' -%}
                {%- when 'pt' -%}{%- assign lc_flag = '🇵🇹' -%}
                {%- when 'ru' -%}{%- assign lc_flag = '🇷🇺' -%}
                {%- when 'pl' -%}{%- assign lc_flag = '🇵🇱' -%}
                {%- when 'cs' -%}{%- assign lc_flag = '🇨🇿' -%}
                {%- when 'sv' -%}{%- assign lc_flag = '🇸🇪' -%}
                {%- when 'da' -%}{%- assign lc_flag = '🇩🇰' -%}
                {%- else -%}{%- assign lc_flag = '🌐' -%}
              {%- endcase -%}
              <li role="listitem">
                <a
                  href="{{ locale.root_url }}"
                  class="announcement-bar__lang-option{% if locale.iso_code == request.locale.iso_code %} is-active{% endif %}"
                  lang="{{ locale.iso_code }}"
                  hreflang="{{ locale.iso_code }}"
                  {% if locale.iso_code == request.locale.iso_code %}aria-current="true"{% endif %}
                >
                  <span aria-hidden="true">{{ lc_flag }}</span>
                  <span>{{ locale.endonym_name }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

    </div>
  </div>
</aside>

{%- comment -%} ── MODAL DE UBICACIÓN + LOGIN ── {%- endcomment -%}
<dialog-component id="location-modal">
  <dialog
    ref="dialog"
    class="location-modal dialog-modal drawer"
    aria-labelledby="location-modal-title"
    aria-modal="true"
  >
    <div class="location-modal__header">
      <h2 id="location-modal-title" class="location-modal__title">
        {{ section.settings.modal_title | default: 'Elige tu ubicación' }}
      </h2>
      <button
        type="button"
        class="location-modal__close button-unstyled"
        on:click="dialog-component/closeDialog"
        aria-label="{{ 'actions.close' | t | default: 'Cerrar' }}"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="location-modal__body">

      {%- comment -%}
        INICIO DE SESIÓN — arriba del todo, igual que las capturas
      {%- endcomment -%}
      {% unless customer %}
        <a
          href="{{ routes.account_login_url }}"
          class="location-modal__login-btn button"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 2h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-3M7 11l3-3-3-3M10 8H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ section.settings.login_label | default: 'Inicia sesión para ver tus direcciones' }}
        </a>
      {% else %}
        <a href="{{ routes.account_url }}" class="location-modal__login-btn button">
          {{ section.settings.account_label | default: 'Ver mi cuenta' }}
        </a>
      {% endunless %}

      <div class="location-modal__divider">
        <span>{{ section.settings.modal_or | default: 'o' }}</span>
      </div>

      {%- comment -%}
        SELECTOR DE PAÍS — usa el form nativo de Shopify 'localization'
        Esto conecta directamente con el sistema de localización de Shopify,
        igual que el header. Cambia moneda, impuestos y envíos reales.
      {%- endcomment -%}
      {% form 'localization', id: 'location-modal-country-form' %}
        <input type="hidden" name="return_to" value="{{ request.path }}">
        <div class="location-modal__select-wrapper">
          {%- comment -%} Bandera del país activo {%- endcomment -%}
          <span class="location-modal__country-flag">
            {{ localization.country.currency.iso_code }}
          </span>
          <select
            name="country_code"
            id="modal-country-selector"
            class="location-modal__select"
          >
            {% for country in localization.available_countries %}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
              >
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {% endfor %}
          </select>
          <span class="location-modal__select-caret" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
        </div>

        <button type="submit" class="location-modal__submit button">
          {{ section.settings.modal_confirm | default: 'Aplicar' }}
        </button>
      {% endform %}

    </div>
  </dialog>
</dialog-component>

{% stylesheet %}
  /* ── Barra base ── */
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  /* ══════════════════════════════════════
     LAYOUT 3-6-3
     Usamos grid con columnas en proporción
     3 = 25%  |  6 = 50%  |  3 = 25%
  ══════════════════════════════════════ */
  .announcement-bar__layout {
    display: grid;
    grid-template-columns: 3fr 6fr 3fr;
    align-items: center;
    width: 100%;
    max-width: var(--page-width, 1280px);
    margin-inline: auto;
    padding-inline: 24px;
    gap: 0;
  }

  /* ── Columnas laterales ── */
  .announcement-bar__side {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .announcement-bar__side--left {
    justify-content: flex-start;
  }

  .announcement-bar__side--right {
    justify-content: flex-end;
  }

  .announcement-bar__side-divider {
    color: rgb(var(--color-foreground-rgb) / 30%);
    font-size: 10px;
    line-height: 1;
  }

  .announcement-bar__side-link {
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0.85;
    transition: opacity 0.15s;
  }

  .announcement-bar__side-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* ── Botón ubicación izquierda ── */
  .announcement-bar__location-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--color-foreground);
    font-family: inherit;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0.85;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  .announcement-bar__location-btn:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .announcement-bar__location-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .announcement-bar__location-name {
    font-size: 11px;
  }

  /* ── Columna central ── */
  .announcement-bar__center {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* ── Slider (original) ── */
  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    width: 100%;
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size, 44px) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;
    place-content: center;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  /* ── Selector de idioma ── */
  .announcement-bar__lang {
    position: relative;
  }

  .announcement-bar__lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    font-family: inherit;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0;
    opacity: 0.85;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  .announcement-bar__lang-trigger:hover {
    opacity: 1;
  }

  .announcement-bar__lang-flag {
    font-size: 14px;
    line-height: 1;
  }

  .announcement-bar__lang-caret {
    display: flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .announcement-bar__lang-trigger[aria-expanded='true'] .announcement-bar__lang-caret {
    transform: rotate(180deg);
  }

  .announcement-bar__lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: auto;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    box-shadow: 0 4px 16px rgb(0 0 0 / 12%);
    list-style: none;
    margin: 0;
    padding: 4px 0;
    z-index: var(--layer-raised, 200);
    min-width: 170px;
    max-height: 300px;
    overflow-y: auto;
  }

  .announcement-bar__lang-dropdown[hidden] {
    display: none;
  }

  .announcement-bar__lang-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    text-decoration: none;
    color: var(--color-foreground);
    font-size: 12px;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .announcement-bar__lang-option:hover {
    background: rgb(var(--color-foreground-rgb) / 6%);
  }

  .announcement-bar__lang-option.is-active {
    font-weight: 700;
  }

  /* ══════════════════════════════════════
     MODAL DE UBICACIÓN
     Diseño igual a capturas: login arriba,
     separador, selector país + botón Aplicar
  ══════════════════════════════════════ */
  .location-modal {
    width: min(440px, 95vw);
    padding: 0;
    border-radius: 8px;
    border: none;
    box-shadow: 0 8px 40px rgb(0 0 0 / 18%);
    background: var(--color-background);
    color: var(--color-foreground);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
  }

  .location-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .location-modal__title {
    font-size: 16px;
    font-weight: 700;
    margin: 0;
    color: var(--color-foreground);
  }

  .location-modal__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--color-foreground);
    transition: background 0.15s;
    cursor: pointer;
    border: none;
    background: none;
    padding: 0;
    opacity: 0.6;
  }

  .location-modal__close:hover {
    opacity: 1;
    background: rgb(var(--color-foreground-rgb) / 8%);
  }

  .location-modal__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Botón de login — azul turquesa igual a las capturas */
  .location-modal__login-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 20px;
    background: #0095B6;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .location-modal__login-btn:hover {
    background: #007a95;
    color: #FFFFFF;
  }

  /* Separador "o" */
  .location-modal__divider {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-foreground);
    opacity: 0.4;
    font-size: 12px;
  }

  .location-modal__divider::before,
  .location-modal__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* Selector de país */
  .location-modal__select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-background);
  }

  .location-modal__country-flag {
    padding-left: 12px;
    font-size: 12px;
    color: var(--color-foreground);
    opacity: 0.6;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .location-modal__select {
    flex: 1;
    padding: 12px 36px 12px 8px;
    border: none;
    background: transparent;
    color: var(--color-foreground);
    font-size: 14px;
    font-family: inherit;
    appearance: none;
    cursor: pointer;
    outline: none;
  }

  .location-modal__select-caret {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-foreground);
    opacity: 0.5;
    display: flex;
    align-items: center;
  }

  /* Botón Aplicar */
  .location-modal__submit {
    width: 100%;
    padding: 14px;
    background: #0095B6;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .location-modal__submit:hover {
    background: #007a95;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 749px) {
    .announcement-bar__layout {
      grid-template-columns: 1fr;
      padding-inline: 16px;
    }

    .announcement-bar__side {
      display: none;
    }

    .announcement-bar__center {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    const trigger = document.querySelector('.announcement-bar__lang-trigger');
    const dropdown = document.getElementById('announcement-lang-dropdown');
    if (!trigger || !dropdown) return;

    trigger.addEventListener('click', function () {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!isOpen));
      dropdown.hidden = isOpen;
    });

    document.addEventListener('click', function (e) {
      if (!trigger.contains(e.target) && !dropdown.contains(e.target)) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.hidden = true;
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !dropdown.hidden) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.hidden = true;
        trigger.focus();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "Columna derecha"
    },
    {
      "type": "checkbox",
      "id": "show_professional_link",
      "label": "Mostrar enlace Profesional",
      "default": true
    },
    {
      "type": "text",
      "id": "professional_label",
      "label": "Texto enlace profesional",
      "default": "Profesional",
      "visible_if": "{{ section.settings.show_professional_link == true }}"
    },
    {
      "type": "url",
      "id": "professional_url",
      "label": "URL enlace profesional",
      "visible_if": "{{ section.settings.show_professional_link == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Mostrar selector de idioma",
      "default": true
    },
    {
      "type": "header",
      "content": "Modal de ubicación"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Título del modal",
      "default": "Elige tu ubicación"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Texto botón iniciar sesión",
      "default": "Inicia sesión para ver tus direcciones"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Texto si sesión activa",
      "default": "Ver mi cuenta"
